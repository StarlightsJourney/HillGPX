# Production deployment — copy to .env on the host machine and fill in real
# values. This file is the template; .env itself is gitignored.

# --- MongoDB ---
# Leave as mongo:27017 — the api container reaches mongo over the compose network.
MONGO_URI=mongodb://mongo:27017
MONGO_DB=hillgpx

# --- API ---
# Restrict to the real origin(s) the site is served on through the tunnel.
CORS_ORIGINS=https://hillgpx.com
# Long random string — guards /api/admin/* moderation endpoints.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=
MAX_UPLOAD_MB=60

# --- Frontend build ---
# Keep empty: nginx proxies the API same-origin, so the built app calls /api.
VITE_API_BASE=

# --- One-time Supabase migration (delete after a successful run) ---
SUPABASE_URL=https://dzpgnebkyubeptitzjlj.supabase.co
SUPABASE_SERVICE_KEY=

# --- Cloudflare Tunnel ---
# Zero Trust → Networks → Tunnels → tunnel → "Install connector" token.
# Public hostname in the dashboard should point to service http://web:80.
CLOUDFLARED_TUNNEL_TOKEN=
