# HillGPX backend + deployment environment.
# Copy to .env for docker compose. Never commit real values.

# --- MongoDB ---
# Inside compose this stays mongo:27017; use localhost:27017 only when running
# the API outside docker.
MONGO_URI=mongodb://mongo:27017
MONGO_DB=hillgpx

# --- API ---
# Origins allowed to call the API cross-origin. "*" is fine while the frontend
# is same-origin through nginx; tighten to your domain for production.
CORS_ORIGINS=*
# Token required on the X-Admin-Token header for /api/admin/* moderation
# endpoints (approve/reject photos, route photos, reports).
ADMIN_TOKEN=change-me
# Largest accepted upload (GPX originals, photos). Must be >= nginx's
# client_max_body_size in web/nginx.conf.
MAX_UPLOAD_MB=60

# --- Frontend build ---
# Empty = same-origin (nginx proxies to the api container). Set to
# http://localhost:8000 in .env.local when running `npm run dev` against the
# dockerised API.
VITE_API_BASE=

# --- One-time Supabase migration (api/migrate_supabase.py) ---
# Service-role key from Supabase dashboard → Settings → API. Required to read
# pending/rejected rows; the publishable key is not enough. Delete after use.
SUPABASE_URL=https://dzpgnebkyubeptitzjlj.supabase.co
SUPABASE_SERVICE_KEY=

# --- Cloudflare Tunnel ---
# Token from Zero Trust → Networks → Tunnels → your tunnel → "Install connector".
# Only needed for `docker compose --profile tunnel up`.
CLOUDFLARED_TUNNEL_TOKEN=
