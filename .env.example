# The web app needs NONE of this. `npm run dev` works with no .env file at all.
#
# These are only for data scripts. Their outputs are committed, so almost nobody
# needs to run them.
#
# Copy to .env.local if you do:  cp .env.example .env.local

# scripts/ingest_hdb.py: recommended OneMap API token.
# Register free at https://www.onemap.gov.sg and generate one from the account page.
ONEMAP_TOKEN=

# Alternative — email and password, from which the script fetches a token each run.
# ONEMAP_EMAIL=
# ONEMAP_PASSWORD=

# scripts/fetch_photos.py only: free from the Mapillary developer dashboard.
# https://www.mapillary.com/dashboard/developers
# The downloaded photos are committed, so nobody needs this token just to run the app.
MAPILLARY_TOKEN=

# Optional: point a fork's web app at its own Supabase project (publishable key only, never service-role).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_KEY=

# scripts/describe_venues.py: any one of these. Groq is free at https://console.groq.com
# FreeLLMAPI is a self-hosted gateway over many free tiers: https://github.com/tashfeenahmed/freellmapi
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# FREELLMAPI_URL=http://localhost:3001/v1
# FREELLMAPI_API_KEY=
