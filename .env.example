# The web app needs NONE of this. `npm run dev` works with no .env file at all.
#
# These are only for scripts/ingest_hdb.py, which regenerates the HDB block list
# from data.gov.sg and needs a OneMap account to geocode addresses. That script
# runs roughly once a year; its output is committed, so almost nobody needs to
# run it.
#
# Copy to .env.local if you do:  cp .env.example .env.local

# Recommended — a OneMap API token.
# Register free at https://www.onemap.gov.sg and generate one from the account page.
ONEMAP_TOKEN=

# Alternative — email and password, from which the script fetches a token each run.
# ONEMAP_EMAIL=
# ONEMAP_PASSWORD=
