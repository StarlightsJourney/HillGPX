# The web app needs NONE of this. `npm run dev` works with no .env file at all.
#
# These are only for scripts/ingest_hdb.py and scripts/fetch_photos.py. Their
# outputs are committed, so almost nobody needs to run them.
#
# Copy to .env.local if you do:  cp .env.example .env.local

# scripts/ingest_hdb.py: recommended OneMap API token.
# Register free at https://www.onemap.gov.sg and generate one from the account page.
ONEMAP_TOKEN=

# Alternative — email and password, from which the script fetches a token each run.
# ONEMAP_EMAIL=
# ONEMAP_PASSWORD=

# scripts/fetch_photos.py only: free from the Mapillary developer dashboard.
# https://www.mapillary.com/dashboard/developers
# The downloaded photos are committed, so nobody needs this token just to run the app.
MAPILLARY_TOKEN=
