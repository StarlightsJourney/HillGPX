# Running the API outside docker (uvicorn on the host).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=hillgpx
STATIC_DIR=../public
CORS_ORIGINS=*
ADMIN_TOKEN=change-me
MAX_UPLOAD_MB=60

# --- Accounts ---
# Google sign-in: OAuth client ID ("Web application") from Google Cloud →
# Credentials. The API verifies ID tokens against this audience; empty =
# Google sign-in off, email sign-up still works.
GOOGLE_CLIENT_ID=
# Bearer-session lifetime in days (default 30).
# SESSION_TTL_DAYS=30
